# The Graph Studio project deploy credentials. Never commit real values.
THEGRAPH_TEST_DEPLOY_KEY=
THEGRAPH_PROD_DEPLOY_KEY=

# Required deployment version labels. Use semver (for example v1.2.3) or a Git SHA.
THEGRAPH_TEST_VERSION_LABEL=
THEGRAPH_PROD_VERSION_LABEL=

# Required only for production deployment. The exact confirmation value is
# documented in docs/deployment.md and intentionally omitted here.
THEGRAPH_PROD_CONFIRM=

# Required for pre-deployment chain and bytecode verification. Treat provider
# URLs containing access tokens as secrets.
ARBITRUM_SEPOLIA_RPC_URL=
ARBITRUM_ONE_RPC_URL=
