{
  "name": "doudochain-subgraph",
  "license": "UNLICENSED",
  "scripts": {
    "codegen": "graph codegen",
    "build": "npm run build:test",
    "build:test": "node scripts/run-environment.mjs build test",
    "build:prod": "node scripts/run-environment.mjs build prod",
    "deploy": "node scripts/run-environment.mjs deploy",
    "deploy:test": "node scripts/run-environment.mjs deploy test",
    "deploy:prod": "node scripts/run-environment.mjs deploy prod",
    "create-local": "graph create --node http://localhost:8020/ doudochain",
    "remove-local": "graph remove --node http://localhost:8020/ doudochain",
    "deploy-local": "graph deploy --node http://localhost:8020/ --ipfs http://localhost:5001 doudochain",
    "parity-gate": "node scripts/parity-gate/run.mjs",
    "pretest": "npm run codegen && node scripts/prepare-matchstick.mjs",
    "test:deployment": "node --test tests/deployment-safety.test.mjs",
    "test": "graph test"
  },
  "dependencies": {
    "@graphprotocol/graph-cli": "0.90.1",
    "@graphprotocol/graph-ts": "0.32.0",
    "graph": "^0.2.0"
  },
  "devDependencies": {
    "matchstick-as": "0.5.0"
  }
}
